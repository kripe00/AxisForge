# ============================================================================
# AXISFORGE ENVIRONMENT CONFIGURATION
# ============================================================================

# Toggle built-in deterministic Dev Mock Mode (true = runs without external API keys)
NEXT_PUBLIC_DEV_MOCK_MODE=true

# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=axisforge-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=axisforge-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=axisforge-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Firebase Admin SDK (Server Authority)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@axisforge-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Tripo 3D Generation API (for sculpted .GLB / .STL 3D meshes)
TRIPO_API_KEY=tsk_your_tripo_secret_key
TRIPO_API_BASE_URL=https://api.tripo3d.ai/v2/openapi

# AI OpenSCAD (.SCAD) Code Generator API (configure any one of these in .env.local)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Bambu Studio CLI Headless Slicer Service
BAMBU_SLICER_MODE=mock # 'mock' | 'cli'
BAMBU_SLICER_CLI_PATH=C:\\Program Files\\Bambu Studio\\bambu-studio.exe
BAMBU_PRINTER_PROFILE=Bambu Lab X1 Carbon 0.4 nozzle
